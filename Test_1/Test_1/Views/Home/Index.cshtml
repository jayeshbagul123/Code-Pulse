@model IEnumerable<Students>
@{
    ViewData["Title"] = "Home Page";
}


<table class="table table-bordered tabke-scripted">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Age</th>
            <th>Standard</th>
            <th>Mobile No</th>
            <th>Address</th>
            <th width="180">Action</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StdName</td>
                <td>@item.Age</td>
                <td>@item.Standard</td>

                <td>@item.MobileNo</td>
                <td>@item.Address</td>
                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.StdId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.StdId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this employee?');">
                        Delete
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>

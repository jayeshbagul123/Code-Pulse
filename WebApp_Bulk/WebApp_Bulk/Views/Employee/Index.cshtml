@model IEnumerable<WebApp_Bulk.Models.Employee>

<a asp-action="Create" class="btn btn-success mb-3">
    Add Employee
</a>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Name</th>

            <th>Department</th>

            <th>Designation</th>

            <th>Salary</th>

            <th>Email</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>@item.EmployeeName</td>

                <td>@item.Department</td>

                <td>@item.Designation</td>

                <td>@item.Salary</td>

                <td>@item.Email</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.EmployeeId"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.EmployeeId"
                       class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>

        }

    </tbody>

</table>